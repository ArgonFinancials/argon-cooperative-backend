# /etc/argon-vfd-proxy/proxy.env on the WALLET's server. 0600 root:root.
# Never in the repository, never in a shell's history (install.sh reads the
# values from files or prompts without echo; README.md, "Installing").
#
# VFD's address and token. THE TOKEN LIVES HERE AND NOWHERE ELSE in the
# cooperative's chain: the cooperative's server holds only PROXY_KEYS' key.
VFD_BASE_URL=https://vfd.example.com/vtech-wallet/api/v1/wallet2
VFD_ACCESS_TOKEN=

# The keys the cooperative signs with, hex (openssl rand -hex 32), comma-
# separated, the CURRENT ONE FIRST. Two only during a rotation (README.md,
# "Rotating the key"); then the old one is removed.
PROXY_KEYS=

# Where nginx reaches it. Loopback only: nginx is the only way in.
PROXY_LISTEN=127.0.0.1:8095
# The record: one JSON line per call, BVNs removed before the line exists.
PROXY_LOG=/var/log/argon-vfd-proxy/requests.log
