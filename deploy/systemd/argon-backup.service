[Unit]
Description=Argon nightly backup to BACKUP_STORE
After=docker.service
Requires=docker.service
OnFailure=argon-alert@%n.service

[Service]
Type=oneshot
Environment=ARGON_ENV=/etc/argon/deploy.env
ExecStart=/usr/bin/bash /opt/argon/src/deploy/50-backup.sh --label nightly
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
PrivateTmp=yes
