[Unit]
Description=Argon API
Documentation=file:///opt/argon/deploy/README.md
After=network-online.target postgresql@18-main.service
Wants=network-online.target
Requires=postgresql@18-main.service
# Crash-looping five times in two minutes stops trying rather than hammering
# the database.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=argon
Group=argon
EnvironmentFile=/etc/argon/argon.env
ExecStart=/opt/argon/bin/argon-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Runaway limits. The host also runs the database holding the ledger; the API
# must not be able to starve it.
MemoryHigh=384M
MemoryMax=512M
CPUQuota=150%
TasksMax=256
LimitNOFILE=4096
OOMScoreAdjust=500

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
