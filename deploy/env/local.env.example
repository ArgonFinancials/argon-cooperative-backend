# Local development. Copy to deploy/env/local.env (gitignored) and fill in.
# Generate passwords with:  openssl rand -base64 24 | tr -d '/+='
#
# TARGET=local: a PostgreSQL server already running on this machine (a native
# install), reached over TCP as its superuser to create the argon_* roles and
# one database of our own. Nothing else on that server is touched; the roles
# are cluster-wide, so they become visible to its other databases.
# (TARGET=docker still works with docker-compose.yml: PGPORT=5433 and the
# compose container's own superuser password.)
TARGET=local
# Our own database on that server, separate from whatever else it holds.
ARGON_DB=argon_test
PGPORT=5432

# The EXISTING superuser of that server. Used for roles and databases only,
# never by the app.
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=

ARGON_MIGRATOR_PASSWORD=
ARGON_APP_PASSWORD=
ARGON_BACKUP_PASSWORD=
# The auth service's role (0005): the only role that mints PIN proofs and
# records sign-in attempts. The API's handlers run as argon_app, which cannot.
ARGON_AUTH_PASSWORD=
# HMAC key for sign-in code digests (the codes themselves are never stored).
# Generate once with:  openssl rand -hex 32   Rotating it invalidates only
# codes already sent (they live five minutes).
ARGON_CODE_KEY=

# Local backups go to a directory; the same scripts take s3:// on EC2.
BACKUP_STORE=file://./.backups

MIGRATE_BIN=migrate
