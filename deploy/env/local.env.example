# Local Docker target. Copy to deploy/env/local.env (gitignored) and fill in.
# Generate passwords with:  openssl rand -base64 24 | tr -d '/+='
TARGET=docker
ARGON_DB=argon
# Host port the container is published on (127.0.0.1 only). NOT 5432: a native
# Postgres on 5432 silently answers instead, and prompts for a password the
# container never set.
PGPORT=5433

# Superuser of the compose container only. Never used by the app.
POSTGRES_PASSWORD=

ARGON_MIGRATOR_PASSWORD=
ARGON_APP_PASSWORD=
ARGON_BACKUP_PASSWORD=

# Local backups go to a directory; the same scripts take s3:// on EC2.
BACKUP_STORE=file://./.backups

MIGRATE_BIN=migrate
