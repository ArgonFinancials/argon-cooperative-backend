# The EC2 server. Copy to /etc/argon/deploy.env on the instance:
#   sudo install -m 0600 -o root -g root deploy/env/ec2.env.example /etc/argon/deploy.env
# then generate the secrets into it (deploy/README.md, "EC2"). Never commit it.
#
# Postgres and the API run as containers (deploy/compose/docker-compose.prod.yml):
# TARGET says where Postgres runs; ARGON_HOST=1 says this machine is the server.
TARGET=docker
ARGON_HOST=1
COMPOSE_FILE=/opt/argon/src/deploy/compose/docker-compose.prod.yml
ARGON_DB=argon
# Published on 127.0.0.1 only (75-assert-loopback.sh checks it).
PGPORT=5432

# The CONTAINER's superuser: roles and databases only, never the app. Anyone
# who can run `docker` on this host is superuser anyway (deploy/README.md,
# "Trust boundary").
POSTGRES_PASSWORD=

ARGON_MIGRATOR_PASSWORD=
ARGON_APP_PASSWORD=
ARGON_BACKUP_PASSWORD=
# The auth service's role (0005): the only role that mints PIN proofs and
# records sign-in attempts. Not in the API's DATABASE_URL.
ARGON_AUTH_PASSWORD=
# HMAC key for sign-in code digests (the codes themselves are never stored).
# Generate once with:  openssl rand -hex 32   Rotating it invalidates only
# codes already sent (they live five minutes).
ARGON_CODE_KEY=

# HMAC key a browser session's CSRF token is derived under (LEDGER_CONTRACT.md
# §12). Required: the server refuses to start without it. Generate once with:
#   openssl rand -hex 32
# Rotating it refuses every live page's CSRF token: each page's next change is
# refused (403 csrf_failed) and it recovers by reloading and re-reading /me.
# No one is signed out and no sign-in is needed. Separate from the code key so
# each can be rotated alone.
ARGON_CSRF_KEY=

# Who sends sign-in codes (deploy/AUTH_SMS.md): termii or refusing, no default;
# 30-install-api.sh refuses an empty value. refusing routes every new device
# to an officer. termii only once AUTH_SMS.md's go-live list is done; then the
# three below, none defaulted. TERMII_URL is https (the key is in the body).
# The key is generated in Termii's dashboard for THIS product's account, never
# one shared with another platform.
ARGON_SMS=
TERMII_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=

# STATED GAP until the S3 bucket exists: this is on the same disk as the
# database, so losing the instance loses both. It is not a backup.
BACKUP_STORE=file:///var/backups/argon
# Once Part B exists (AWS_REQUEST.md):
#   BACKUP_STORE=s3://CHANGE-ME-argon-backups/prod
BACKUP_SSE=AES256
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

MIGRATE_BIN=/usr/local/bin/migrate
MIGRATIONS_DIR=/opt/argon/src/migrations
# The restore drill's test binary, built once by 30-install-api.sh (the drill
# unit's memory cap leaves no room to build it during a drill).
TIER1_BIN=/opt/argon/bin/tier1.test

# Ports allowed to listen beyond loopback (75-assert-loopback.sh). sshd only,
# until a domain and TLS exist: then nginx's 443 joins it, never 80 for sign-in.
PUBLIC_PORTS=22

# Toolchain pins (15-install-tools.sh). sha256 is go.dev's published checksum.
GO_VERSION=1.27.1
GO_SHA256_ARM64=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec
MIGRATE_VERSION=v4.18.1

API_PORT=8080

# Browser origins that may call the API (CORS; internal/api/cors.go):
# comma-separated, matched EXACTLY, never a wildcard. EMPTY = NO BROWSER ORIGIN
# (closed by default). Production's value is a decision someone makes when the
# frontend's domain exists, not a default it inherits.
# HARD REQUIREMENT ON THAT DECISION (LEDGER_CONTRACT.md §12): the app and the
# API must be subdomains of ONE registrable domain (app.<domain>, api.<domain>).
# Otherwise every API call is cross-site and no SameSite value sends the
# session cookie.
# Once ARGON_API_DOMAIN is set this is the app's ONE https origin under the
# same domain, and nothing else: 30-install-api.sh and 86-install-tls.sh
# refuse anything more (deploy/nginx/check-origin.sh).
ARGON_ALLOWED_ORIGINS=

# GOING LIVE (86-install-tls.sh, 87-prove-renewal.sh; README "Going live").
# The API's public name, e.g. api.<domain>. Empty: the API is on loopback only,
# and 75-assert-loopback.sh refuses 80 and 443. Set: nginx serves it on 443,
# port 80 carries the certificate check and redirects, and 80 and 443 are
# public for nginx alone.
ARGON_API_DOMAIN=
# Let's Encrypt's contact for this certificate: it writes here if a renewal is
# failing and the certificate is about to expire. A mailbox someone reads.
ACME_EMAIL=
# 65-check-freshness.sh alerts when the served certificate has fewer than
# CERT_MIN_DAYS (default 21) days left. Not set here: the runbook makes that
# alert fire once with CERT_MIN_DAYS=100 on the command line, which a line in
# this file would silently override.

# Alerts (deploy/alert.sh, 65-check-freshness.sh; README "Alerts").
# Every alert always goes to the journal and the SSH login banner. The channel
# is who gets TOLD:  none (nobody, said loudly) | sns | webhook
ALERT_CHANNEL=none
ALERT_SNS_TOPIC_ARN=
ALERT_WEBHOOK_URL=
# An outside dead-man's switch (e.g. a healthchecks.io check, or a CloudWatch
# alarm on missing data): pinged when backups are fresh; it alerts when the
# pings STOP, which is how a dead server gets noticed.
ALERT_HEARTBEAT_URL=
BACKUP_MAX_AGE_H=26
DRILL_MAX_AGE_D=8
BACKUP_MIN_FREE_GB=5
