#!/bin/sh
# /etc/update-motd.d/60-argon-alerts: open Argon alerts, at every SSH login,
# until acknowledged (sudo ARGON_ENV=/etc/argon/deploy.env bash /opt/argon/src/deploy/alert.sh ack all).
d=/var/lib/argon/alerts/open
n=$(ls -1 "$d" 2>/dev/null | wc -l)
[ "$n" -gt 0 ] || exit 0
printf '\n\033[1;31m  %s OPEN ARGON ALERT(S): the backups may not be good.\033[0m\n' "$n"
ls -1 "$d" | tail -5 | while read -r f; do printf '    %s  %s\n' "$f" "$(sed -n 's/^subject: //p' "$d/$f")"; done
printf '  List:  sudo ARGON_ENV=/etc/argon/deploy.env bash /opt/argon/src/deploy/alert.sh list\n\n'
