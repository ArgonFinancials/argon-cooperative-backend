{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::CHANGE-ME-argon-backups",
      "Condition": { "StringLike": { "s3:prefix": ["prod/*"] } }
    },
    {
      "Sid": "WriteAndReadBackups_NoDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::CHANGE-ME-argon-backups/prod/*"
    }
  ]
}
