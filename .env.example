# Copy to .env. Never commit .env.
# The app connects as argon_app — never the superuser, never the table owner.
# The password is ARGON_APP_PASSWORD from deploy/env/local.env.
DATABASE_URL=postgres://argon_app:CHANGE-ME@127.0.0.1:5433/argon?sslmode=disable
PORT=8081
ENV=development
# The auth service's OWN connection, as argon_auth (ARGON_AUTH_PASSWORD), and
# the code key (ARGON_CODE_KEY). Both or neither: with neither, sign-in and
# the PIN step-up answer a deliberate 503.
AUTH_DATABASE_URL=postgres://argon_auth:CHANGE_ME@127.0.0.1:5432/argon_test?sslmode=disable
AUTH_CODE_KEY=
# HMAC key a browser session's CSRF token is derived under (LEDGER_CONTRACT.md
# §12). Required: the server refuses to start without it. Generate once with:
#   openssl rand -hex 32
# Rotating it refuses every live page's CSRF token: each page's next change is
# refused (403 csrf_failed) and it recovers by reloading and re-reading /me.
# No one is signed out and no sign-in is needed. Separate from the code key so
# each can be rotated alone.
ARGON_CSRF_KEY=
# Who sends sign-in codes, with an auth service: termii or refusing, no
# default (deploy/AUTH_SMS.md). Locally, refusing: a new device is routed to an
# officer. termii needs TERMII_URL (https), TERMII_API_KEY, TERMII_SENDER_ID.
ARGON_SMS=
# Browser origins that may call the API (CORS): exact, comma-separated, never
# "*". Empty means none. Locally, the frontend's Next.js dev server.
#
# THE APP MUST CALL THE API AS http://localhost:8081, NEVER http://127.0.0.1:8081.
# "localhost" and "127.0.0.1" are different SITES to a browser: from a page on
# localhost:3000, a call to 127.0.0.1 is cross-site, and the session cookie
# (SameSite=Strict) is silently not sent. Every call then reads "sign in again"
# with nothing in any log to say why. (Ports do not matter to "site"; hosts do.)
ARGON_ALLOWED_ORIGINS=http://localhost:3000
